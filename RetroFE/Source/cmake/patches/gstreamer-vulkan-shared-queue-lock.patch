+/* The DPB image may be read again before the application presents it. Cache
+ * an independent output on each decoder-pool memory, and copy on the decode
+ * queue inside the decode submission. Never transition a live DPB on SDL's
+ * graphics queue. A busy cached output is replaced while its consumer owns it. */
+static GstBuffer *
+decoder_presentation_buffer (GstVulkanDecoder * self, GstBuffer * out)
+{
+  GstVulkanImageMemory *source = (GstVulkanImageMemory *)
+      gst_buffer_peek_memory (out, 0);
+  GQuark key = g_quark_from_static_string ("retrofe-vulkan-presentation");
+  GstBuffer *buffer = gst_mini_object_get_qdata (GST_MINI_OBJECT_CAST (source), key);
+  if (!buffer || !gst_buffer_is_writable (buffer) ||
+      !gst_memory_is_writable (gst_buffer_peek_memory (buffer, 0))) {
+    GArray *families = gst_vulkan_device_queue_family_indices (self->queue->device);
+    VkImageCreateInfo image = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = source->create_info.format,
+      .extent = source->create_info.extent,
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT
+          | VK_IMAGE_USAGE_SAMPLED_BIT,
+      .sharingMode = families->len > 1 ? VK_SHARING_MODE_CONCURRENT : VK_SHARING_MODE_EXCLUSIVE,
+      .queueFamilyIndexCount = families->len > 1 ? families->len : 0,
+      .pQueueFamilyIndices = families->len > 1 ? (guint32 *) families->data : NULL,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    GstMemory *memory = gst_vulkan_image_memory_alloc_with_image_info (
+        self->queue->device, &image, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    g_array_unref (families);
+    if (!memory)
+      return NULL;
+    buffer = gst_buffer_new ();
+    gst_buffer_append_memory (buffer, memory);
+    gst_mini_object_set_qdata (GST_MINI_OBJECT_CAST (source), key, buffer,
+        (GDestroyNotify) gst_buffer_unref);
+  }
+  return buffer;
+}
