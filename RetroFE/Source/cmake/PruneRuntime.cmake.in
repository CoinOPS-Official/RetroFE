cmake_minimum_required(VERSION 3.24)
file(REAL_PATH "${OUTPUT_DIR}" output_real)
file(REAL_PATH "@CMAKE_BINARY_DIR@" build_real)
cmake_path(IS_PREFIX build_real "${output_real}" NORMALIZE inside_build)
if(NOT inside_build OR output_real STREQUAL build_real)
    message(FATAL_ERROR "Refusing to stage/prune outside a configured build output subdirectory")
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_LINKER@")
# CMake's linker path is link.exe; dumpbin lives alongside it.
get_filename_component(tool_dir "@CMAKE_LINKER@" DIRECTORY)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${tool_dir}/dumpbin.exe")
set(seeds "@runtime_dlls@")
list(APPEND seeds ${EXTRA_FILES})
# Source-built packages can expose only configuration-specific locations.
# Include resolved target DLL directories when locating their dependencies.
set(search_dirs)
foreach(path IN LISTS EXTRA_FILES)
    get_filename_component(dir "${path}" DIRECTORY)
    list(APPEND search_dirs "${dir}")
endforeach()
list(APPEND search_dirs @runtime_dirs@)
list(REMOVE_DUPLICATES search_dirs)
set(scanner "@scanner@")
file(GET_RUNTIME_DEPENDENCIES
    LIBRARIES ${seeds}
    EXECUTABLES "${scanner}"
    DIRECTORIES ${search_dirs}
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\].*"
    RESOLVED_DEPENDENCIES_VAR dependencies
    UNRESOLVED_DEPENDENCIES_VAR missing)
if(missing)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${missing}")
endif()
set(files ${seeds} ${dependencies} "${scanner}")
list(REMOVE_DUPLICATES files)
set(keep)
foreach(path IN LISTS files)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    list(APPEND keep "${name}")
    file(COPY_FILE "${path}" "${OUTPUT_DIR}/${name}" ONLY_IF_DIFFERENT)
endforeach()
# Remove only known GStreamer-distribution DLLs from this generated output,
# never recurse or touch an installation, backup, or arbitrary user files.
file(GLOB gst_candidates "@GSTREAMER_ROOT@/bin/*.dll"
    "@GSTREAMER_ROOT@/lib/gstreamer-1.0/*.dll")
foreach(path IN LISTS gst_candidates)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    if(NOT name IN_LIST keep)
        file(REMOVE "${output_real}/${name}")
    endif()
endforeach()
# These obsolete application libraries must not survive an incremental build.
if(REMOVE_LEGACY_TESTS)
    foreach(test retrofe_sdl3_smoke_tests retrofe_high_score_change_tests retrofe_mame_software_resolver_tests)
        foreach(extension exe pdb ilk)
            file(REMOVE "${output_real}/${test}.${extension}")
        endforeach()
    endforeach()
endif()
foreach(name SDL2.dll SDL2_image.dll SDL2_mixer.dll SDL2_ttf.dll)
    file(REMOVE "${output_real}/${name}")
endforeach()
set(runtime_licenses "@runtime_licenses@")
foreach(entry IN LISTS runtime_licenses)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 source)
    list(GET parts 1 relative)
    get_filename_component(directory "${OUTPUT_DIR}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${source}" "${OUTPUT_DIR}/${relative}" ONLY_IF_DIFFERENT)
    list(APPEND keep "${relative}")
endforeach()
list(REMOVE_DUPLICATES keep)
list(SORT keep)
list(JOIN keep "\n" manifest)
file(WRITE "${OUTPUT_DIR}/runtime-files.txt" "${manifest}\n")
list(LENGTH keep count)
message(STATUS "Staged ${count} runtime files (curated GStreamer plugins and dependency closure)")
