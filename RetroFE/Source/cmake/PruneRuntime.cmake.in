cmake_minimum_required(VERSION 3.24)
file(REAL_PATH "${OUTPUT_DIR}" output_real)
file(REAL_PATH "@CMAKE_BINARY_DIR@" build_real)
cmake_path(IS_PREFIX build_real "${output_real}" NORMALIZE inside_build)
if(NOT inside_build OR output_real STREQUAL build_real)
    message(FATAL_ERROR "Refusing to stage/prune outside a configured build output subdirectory")
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_LINKER@")
# CMake's linker path is link.exe; dumpbin lives alongside it.
get_filename_component(tool_dir "@CMAKE_LINKER@" DIRECTORY)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${tool_dir}/dumpbin.exe")
set(seeds "@runtime_dlls@")
set(gst_plugin_files "@gst_plugin_files@")
list(APPEND seeds ${EXTRA_FILES})
# Source-built packages can expose only configuration-specific locations.
# Include resolved target DLL directories when locating their dependencies.
set(search_dirs)
foreach(path IN LISTS EXTRA_FILES)
    get_filename_component(dir "${path}" DIRECTORY)
    list(APPEND search_dirs "${dir}")
endforeach()
# Explicit dependency seeds take priority over similarly named SDK libraries
# (for example the application's libcurl versus GStreamer's bundled libcurl).
set(preferred_seeds ${seeds})
list(REVERSE preferred_seeds)
foreach(path IN LISTS preferred_seeds)
    get_filename_component(dir "${path}" DIRECTORY)
    list(APPEND search_dirs "${dir}")
endforeach()
list(APPEND search_dirs @runtime_dirs@)
list(REMOVE_DUPLICATES search_dirs)
set(scanner "@scanner@")
# Inspect the executable away from old staged DLLs so dependency resolution
# selects the configured SDKs rather than conflicting copies from a prior build.
get_filename_component(executable_name "${RUNTIME_EXECUTABLE}" NAME)
string(SHA256 output_id "${output_real}")
set(analysis_dir "${build_real}/runtime-dependencies/${output_id}")
file(MAKE_DIRECTORY "${analysis_dir}")
set(analysis_executable "${analysis_dir}/${executable_name}")
file(COPY_FILE "${RUNTIME_EXECUTABLE}" "${analysis_executable}" ONLY_IF_DIFFERENT)
file(GET_RUNTIME_DEPENDENCIES
    LIBRARIES ${seeds}
    EXECUTABLES "${scanner}" "${analysis_executable}"
    DIRECTORIES ${search_dirs}
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\].*"
    RESOLVED_DEPENDENCIES_VAR dependencies
    UNRESOLVED_DEPENDENCIES_VAR missing)
file(REMOVE "${analysis_executable}")
if(missing)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${missing}")
endif()
set(files ${seeds} ${dependencies} "${scanner}")
list(REMOVE_DUPLICATES files)
set(plugin_names)
foreach(path IN LISTS gst_plugin_files)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    list(APPEND plugin_names "${name}")
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/gst-plugins")
set(keep)
foreach(path IN LISTS files)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    # Only loadable plugins belong in the scan directory. Shared libraries
    # remain beside the executable for Windows import resolution and scanner use.
    if(name IN_LIST plugin_names)
        set(relative "gst-plugins/${name}")
    else()
        set(relative "${name}")
    endif()
    if(relative IN_LIST keep)
        continue()
    endif()
    list(APPEND keep "${relative}")
    file(COPY_FILE "${path}" "${OUTPUT_DIR}/${relative}" ONLY_IF_DIFFERENT)
endforeach()
# Remove only known GStreamer-distribution DLLs from this generated output,
# never recurse or touch an installation, backup, or arbitrary user files.
file(GLOB gst_candidates "@GSTREAMER_ROOT@/bin/*.dll"
    "@GSTREAMER_ROOT@/lib/gstreamer-1.0/*.dll")
foreach(path IN LISTS gst_candidates)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    if(NOT name IN_LIST keep)
        file(REMOVE "${output_real}/${name}")
    endif()
endforeach()
# Prune obsolete plugins from the generated scan directory as well, including
# the optional locally built Vulkan plugin when a build switches Vulkan off.
file(GLOB plugin_candidates "@GSTREAMER_ROOT@/lib/gstreamer-1.0/*.dll")
list(APPEND plugin_candidates "gstvulkan.dll")
foreach(path IN LISTS plugin_candidates)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    if(NOT "gst-plugins/${name}" IN_LIST keep)
        file(REMOVE "${output_real}/gst-plugins/${name}")
    endif()
endforeach()
# SDK upgrades can change FFmpeg DLL majors. Remove only recognized FFmpeg
# library names absent from the resolved dependency set (GStreamer may need older ones).
file(GLOB ffmpeg_candidates "${output_real}/avcodec-*.dll" "${output_real}/avformat-*.dll"
    "${output_real}/avutil-*.dll" "${output_real}/swresample-*.dll" "${output_real}/swscale-*.dll")
foreach(path IN LISTS ffmpeg_candidates)
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" name)
    if(name MATCHES "^(avcodec|avformat|avutil|swresample|swscale)-[0-9]+[.]dll$" AND NOT name IN_LIST keep)
        file(REMOVE "${path}")
    endif()
endforeach()
# These obsolete application libraries must not survive an incremental build.
if(REMOVE_LEGACY_TESTS)
    foreach(test retrofe_sdl3_smoke_tests retrofe_high_score_change_tests retrofe_mame_software_resolver_tests
            retrofe_text_benchmark retrofe_page_traversal_benchmark
            retrofe_vulkan_context_smoke retrofe_vulkan_interop_smoke retrofe_ffmpeg_vulkan_interop_smoke
            upstream-vkdownload upstream-vkupload upstream-vkimagebufferpool
            openhi2txt_xml_parser_tests openhi2txt_open_extension_tests openhi2txt_input_planner_tests
            openhi2txt_live_protocol_tests openhi2txt_identity_resolution_tests)
        foreach(extension exe pdb ilk)
            file(REMOVE "${output_real}/${test}.${extension}")
        endforeach()
    endforeach()
endif()
foreach(name SDL2.dll SDL2_image.dll SDL2_mixer.dll SDL2_ttf.dll)
    file(REMOVE "${output_real}/${name}")
endforeach()
set(runtime_licenses "@runtime_licenses@")
foreach(entry IN LISTS runtime_licenses)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 source)
    list(GET parts 1 relative)
    get_filename_component(directory "${OUTPUT_DIR}/${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${source}" "${OUTPUT_DIR}/${relative}" ONLY_IF_DIFFERENT)
    list(APPEND keep "${relative}")
endforeach()
list(REMOVE_DUPLICATES keep)
list(SORT keep)
foreach(name IN LISTS keep)
    if(NOT EXISTS "${OUTPUT_DIR}/${name}")
        message(FATAL_ERROR "Staged runtime file is missing: ${OUTPUT_DIR}/${name}")
    endif()
endforeach()
list(JOIN keep "\n" manifest)
file(WRITE "${OUTPUT_DIR}/runtime-files.txt" "${manifest}\n")
list(LENGTH keep count)
message(STATUS "Staged ${count} runtime files (curated GStreamer plugins and dependency closure)")
